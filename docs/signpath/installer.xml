<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the zip holds the Inno Setup installer, which also signs its uninstaller content. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <zip-file>
    <pe-file path="HapticBridge-Setup-${version}.exe" product-name="Haptic Bridge" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
