<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>HapticGamingBridge</AssemblyName>
    <RootNamespace>HapticGamingBridge</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Binary metadata. SignPath checks that product name and version are the same in every signed file. -->
    <Product>Haptic Gaming Bridge</Product>
    <Version>1.2.0</Version>
    <Company>giovannimazza</Company>
    <Authors>giovannimazza</Authors>
    <Description>Haptic feedback for games on the Logitech MX Master 4</Description>
    <Copyright>Copyright (c) 2026 giovannimazza</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="icon-header.png" />
    <Resource Include="icon-large.png" />
  </ItemGroup>
</Project>
