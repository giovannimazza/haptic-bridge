<Window x:Class="HapticGamingBridge.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Border x:Name="IconBox" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock x:Name="IconText" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Orange}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="NoBtn" Content="No" Style="{StaticResource Btn}" Padding="22,9" IsCancel="True" Click="No_Click" />
            <Button x:Name="YesBtn" Content="Yes" Style="{StaticResource BtnPrimary}" Padding="22,9" Margin="10,0,0,0" IsDefault="True" Click="Yes_Click" />
        </StackPanel>
    </Grid>
</Window>
