<Window x:Class="HapticGamingBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HapticGamingBridge"
        PreviewKeyDown="Window_PreviewKeyDown" Title="Haptic Gaming Bridge" Width="1180" Height="740" MinWidth="960" MinHeight="580" Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Top bar ============ -->
        <Border Grid.ColumnSpan="2" Padding="16,12,24,12" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="icon-header.png" Width="36" Height="36" Margin="-2,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="Haptic Gaming Bridge" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <RadioButton x:Name="TabProfiles" GroupName="Tabs" Content="Profiles" IsChecked="True" Style="{StaticResource TabBtn}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabInfo" GroupName="Tabs" Content="Info" Style="{StaticResource TabBtn}" Margin="4,0,0,0" Checked="Tab_Checked" />
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource PayPalBtn}" Tag="https://paypal.me/giovanbattistamazza" Click="Link_Click" VerticalAlignment="Center" Margin="18,0,0,0" />
                <Button DockPanel.Dock="Left" Style="{StaticResource KofiBtn}" Tag="https://ko-fi.com/giovanbattistamazza" Click="Link_Click" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border x:Name="StatusPill" DockPanel.Dock="Right" CornerRadius="14" Padding="12,5" Background="{StaticResource Hover}" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="StatusText" Text="Plugin not found" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <CheckBox x:Name="EnabledSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" Content="Haptics on" Foreground="{StaticResource Text}"
                          VerticalAlignment="Center" Click="EnabledSwitch_Click" />
                <Border />
            </DockPanel>
        </Border>


        <!-- ============ Update banner ============ -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Padding="24,10"
                Background="{StaticResource Selected}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="UpdateNowBtn" Content="Update now" Style="{StaticResource BtnPrimary}" Padding="14,6" Click="UpdateNow_Click" />
                    <Button x:Name="UpdateNotesBtn" Content="What's new" Style="{StaticResource Btn}" Padding="12,6" Margin="8,0,0,0" Click="UpdateNotes_Click" />
                    <Button x:Name="UpdateSkipBtn" Content="Skip this version" Style="{StaticResource Btn}" Padding="12,6" Margin="8,0,0,0" Click="UpdateSkip_Click" />
                    <Button x:Name="UpdateCloseBtn" Content="x" Style="{StaticResource BtnIcon}" Margin="8,0,0,0" ToolTip="Hide" Click="UpdateClose_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateText" Foreground="{StaticResource Text}" FontWeight="SemiBold" Text="An update is available" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="UpdateProgress" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" Margin="0,6,0,2" Visibility="Collapsed" />
                    <TextBlock x:Name="UpdateDetail" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Profile sidebar ============ -->
        <Border Grid.Row="2" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GAME PROFILES" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="4,4,0,12" />
                <Button DockPanel.Dock="Bottom" Content="+ New profile" Style="{StaticResource BtnPrimary}" Padding="14,12" Click="AddProfile_Click" />
                <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" Margin="0,0,0,12" HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource ProfileItem}" SelectionChanged="ProfileList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Red}"
                                        FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" FontSize="14" ToolTip="Delete profile" Padding="7,5" Margin="6,0,0,0"
                                        Click="DeleteProfileRow_Click" />
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource MiniSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="8,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Turn this profile on or off (keeps its actions)" />
                                <Ellipse x:Name="Dot" DockPanel.Dock="Right" Width="8" Height="8" Fill="{StaticResource Green}" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="In foreground" />
                                <Border x:Name="RowIcon" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="6" Background="{StaticResource Hover}" Margin="0,0,10,0">
                                    <Image Source="{Binding Icon}" Margin="3" />
                                </Border>
                                <StackPanel x:Name="RowName" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold" MaxWidth="84" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               MouseLeftButtonDown="RenameRow_MouseDown" ToolTip="Double-click to rename" />
                                    <ContentControl Style="{StaticResource RunIcon}" FontSize="14" Margin="8,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="RowIcon" Property="Opacity" Value="0.4" />
                                    <Setter TargetName="RowName" Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Empty state ============ -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="icon-large.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
            <TextBlock Text="Select a profile or create a new one" Foreground="{StaticResource Muted}" Margin="0,16,0,0" />
        </StackPanel>

        <!-- ============ Profile detail: cards + side editor ============ -->
        <Grid x:Name="DetailView" Grid.Row="2" Grid.Column="1" Margin="24,20,24,16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!-- Game header -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Change app" Style="{StaticResource Btn}" Padding="12,7" Click="ChangeApp_Click" />
                            <Button Content="Duplicate" Style="{StaticResource Btn}" Padding="12,7" Margin="8,0" Click="Duplicate_Click" />
                            <Button Content="+ Add action" Style="{StaticResource BtnPrimary}" Padding="14,7" Click="AddAction_Click" />
                        </WrapPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{StaticResource Field}" Margin="0,0,14,0">
                            <Image Source="{Binding Icon}" Margin="6" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonDown="RenameRow_MouseDown" />
                                <ContentControl Style="{StaticResource RunIcon}" FontSize="18" Margin="10,3,0,0" />
                                <Button Style="{StaticResource BtnIcon}" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Muted}"
                                        FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" FontSize="14" Padding="7,5" Margin="6,2,0,0" VerticalAlignment="Center"
                                        ToolTip="Rename profile (F2)" Click="Rename_Click" />
                                <Border CornerRadius="10" Padding="9,3" Margin="12,4,0,0" Background="{StaticResource Hover}" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Disabled" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Exe}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ACTIONS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="290" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,14,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Edit" Style="{StaticResource BtnIcon}" Click="EditAction_Click" />
                                                    <Button Content="x" Style="{StaticResource BtnIcon}" Margin="6,0,0,0" Foreground="{StaticResource Red}" Click="RemoveAction_Click" />
                                                </StackPanel>
                                                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,3" CornerRadius="6"
                                                        Padding="12,5" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding TriggerLabel}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text}" />
                                                </Border>
                                            </DockPanel>
                                            <ComboBox Margin="0,14,0,0" Height="34" ItemsSource="{x:Static local:Events.Patterns}"
                                                      SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding Event, Mode=TwoWay}" />
                                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="MODIFIER" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ModifierLabel}" Foreground="{StaticResource Text}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="COOLDOWN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding CooldownMs, StringFormat={}{0} ms}" Foreground="{StaticResource Text}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="HOLD" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                                                    <CheckBox IsChecked="{Binding Repeat, Mode=TwoWay}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{StaticResource Row}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,4,14,0">
                            <StackPanel>
                                <TextBlock Text="Tips" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" Text="• Shooting: map the fire button to a recoil pattern and turn on Hold. If you know the weapon's rounds per minute, type it in the action editor and the cooldown is set for you." />
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" Text="• Walking: Hold on with a cooldown near 160 ms feels like footsteps." />
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Text="• Fewer mappings feel better than one on every control." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Side editor: replaces the tips column while an action is open -->
            <Border x:Name="EditorView" Grid.Column="1" Width="340" Margin="8,0,0,0" VerticalAlignment="Stretch" Visibility="Collapsed"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="12" Padding="20">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="x" Style="{StaticResource BtnIcon}" Click="EditorBack_Click" />
                        <TextBlock x:Name="EditorTitle" Text="Add New Action" Foreground="{StaticResource Text}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource BtnPrimary}" Padding="24,9" Click="SaveAction_Click" />
                        <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="EditorBack_Click" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">

                    <TextBlock Text="Trigger type" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
                    <ComboBox x:Name="TypeBox" SelectionChanged="TypeBox_SelectionChanged" />

                    <TextBlock Text="Input (click, then press it)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,6" />
                    <Button x:Name="CaptureBtn" Content="Click to capture input" Style="{StaticResource Btn}" Padding="12,10" Click="Capture_Click" />

                    <TextBlock Text="Haptic pattern" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,6" />
                    <ComboBox x:Name="PatternBox" SelectedValuePath="Id" DisplayMemberPath="Label" />
                    <Button x:Name="TestBtn" Content="Test (hold to repeat)" Style="{StaticResource Btn}" Margin="0,8,0,0"
                            PreviewMouseLeftButtonDown="Test_Down" PreviewMouseLeftButtonUp="Test_Up" LostMouseCapture="Test_Lost" />

                    <TextBlock Text="Required modifier" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,6" />
                    <ComboBox x:Name="ModBox" SelectedValuePath="Id" DisplayMemberPath="Label" />

                    <TextBlock Text="Cooldown between triggers (ms)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,6" />
                    <DockPanel>
                        <TextBox x:Name="CooldownBox" DockPanel.Dock="Right" Width="64" Margin="12,0,0,0" TextAlignment="Center" TextChanged="CooldownBox_TextChanged" />
                        <Slider x:Name="CooldownSlider" Minimum="0" Maximum="1000" SmallChange="5" LargeChange="25" IsMoveToPointEnabled="True"
                                VerticalAlignment="Center" ValueChanged="CooldownSlider_ValueChanged" />
                    </DockPanel>

                    <TextBlock Text="Rounds per minute (sets the cooldown for you)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,6" />
                    <DockPanel>
                        <TextBox x:Name="RpmBox" DockPanel.Dock="Left" Width="76" TextAlignment="Center" TextChanged="RpmBox_TextChanged" LostFocus="RpmBox_LostFocus"
                                 ToolTip="A weapon's rate of fire, for example 600. Cooldown = 60000 / rounds per minute." />
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Button Content="300" Tag="300" Style="{StaticResource BtnIcon}" Click="Rpm_Preset_Click" Margin="0,0,4,0" />
                            <Button Content="600" Tag="600" Style="{StaticResource BtnIcon}" Click="Rpm_Preset_Click" Margin="0,0,4,0" />
                            <Button Content="900" Tag="900" Style="{StaticResource BtnIcon}" Click="Rpm_Preset_Click" Margin="0,0,4,0" />
                            <Button Content="1200" Tag="1200" Style="{StaticResource BtnIcon}" Click="Rpm_Preset_Click" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="RateHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <CheckBox x:Name="HoldBox" Content="Repeat while held" Margin="0,16,0,0" />

                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Info tab: covers the sidebar and the profile area while selected ============ -->
        <ScrollViewer x:Name="InfoView" Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Bg}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border MaxWidth="760" Margin="30,28,30,0" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Haptic feedback for games on the MX Master 4" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,18" />
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="What it does" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,0" Text="Haptic Gaming Bridge makes your Logitech MX Master 4 vibrate when you press the keys and mouse buttons you choose while playing, a bit like the rumble of a game controller. It watches your input, picks the profile of the game that is in the foreground, and asks the Logi Options+ plugin to play a vibration." />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Getting started" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,0" Text="1.  Install the Logi Options+ plugin (the installer offers it) and keep Logi Options+ running." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="2.  Press  + New profile  and pick your game from the running programs, or browse to its .exe." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="3.  Press  + Add action : choose a key or mouse button, a haptic pattern, an optional modifier, a cooldown (or type a rounds-per-minute value and the cooldown is worked out for you) and whether to repeat while held. Use Test to feel the pattern." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="4.  Play. The green dot next to a profile shows which one is active right now; only the game in the foreground triggers vibrations." />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Good to know" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,0" Text="The pill at the top shows whether the plugin is running. Orange (Plugin not found) means nothing will vibrate until Logi Options+ and the plugin are running." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="The switch at the top turns all haptics on or off. The small switch next to a profile turns just that profile off, without deleting its actions. To rename a profile, press the pencil next to its name, double-click the name, or press F2." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="Cooldown is the minimum time between two pulses. The mouse merges or drops pulses that arrive too close together, so a very short cooldown does not feel faster. With Hold, around 75 to 350 ms feels natural for shooting and around 160 ms for footsteps." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="Rounds per minute: to match a weapon's rate of fire, type it in the action editor. The cooldown is 60000 divided by that number, so 600 rounds per minute is a 100 ms cooldown, and the two boxes stay in sync. Turn on Hold so the pulse repeats at that rate. Below 50 ms (above 1200 per minute) the real rate is only approximate." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="Each trigger is a short pulse. The mouse cannot hold a continuous vibration." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="If a game runs as administrator, run Haptic Gaming Bridge as administrator too, otherwise Windows hides the game's input from it." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="Updates: when a newer version is out, a banner at the top offers it. Update now downloads the installer, checks it against the checksum GitHub published, installs it and restarts the app, keeping your profiles. You can check by hand, turn the automatic check off, or let updates install at startup under Updates below. The Logi plugin is not replaced by an update; the release notes say when a new one is needed." />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="Not tested with anti-cheat software." />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Privacy" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,0" Text="The only thing the app does on the network is look for updates. It asks GitHub for the latest release of this project (api.github.com) and, if you update, downloads the installer from GitHub, which sees your IP address as any website would. The request carries only the app name and version number: no profiles, no keys you press, no identifier. You can turn this off under Updates, and then the app makes no network connections at all. It listens to keyboard and mouse presses only to match the actions you set up: it does not record or store them. Your profiles and settings are saved on this PC in %APPDATA%\HapticGamingBridge. The only connection to the plugin is a local one that only your Windows account can open. The links in this app open in your browser." />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Updates" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Text="Not checked yet." />
                            <Button x:Name="CheckNowBtn" Content="Check for updates" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="CheckNow_Click" />
                            <CheckBox x:Name="AutoCheckBox" Content="Check for updates automatically" Margin="0,16,0,0" Click="UpdateSettings_Click" />
                            <CheckBox x:Name="AutoInstallBox" Content="Install updates automatically when the app starts" Margin="0,8,0,0" Click="UpdateSettings_Click" />
                            <TextBlock x:Name="AutoInstallNote" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0" />
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0"
                                       Text="An update is only installed after its SHA-256 matches the checksum GitHub published for that release file. Releases are not code-signed yet, so Windows may show a warning." />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22,18" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="About" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource Text}" Text="Haptic Gaming Bridge" />
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" Text="Free and open source under the MIT license. Independent project, not affiliated with or endorsed by Logitech. Source code, releases and bug reports are on GitHub." />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Open on GitHub" Style="{StaticResource BtnPrimary}" Tag="https://github.com/giovannimazza/haptic-bridge" Click="Link_Click" />
                                <Button Content="Report an issue" Style="{StaticResource Btn}" Margin="8,0,0,0" Tag="https://github.com/giovannimazza/haptic-bridge/issues" Click="Link_Click" />
                                <Button Content="Releases" Style="{StaticResource Btn}" Margin="8,0,0,0" Tag="https://github.com/giovannimazza/haptic-bridge/releases" Click="Link_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
