<Window x:Class="HapticGamingBridge.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Application" Width="560" Height="540" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Select Application" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Choose from running applications or browse for an executable" Foreground="{StaticResource Muted}" Margin="0,4,0,14" />
        </StackPanel>

        <TextBox x:Name="Search" Grid.Row="1" Margin="0,0,0,10" TextChanged="Search_TextChanged" />

        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Margin="6"
                     ItemContainerStyle="{StaticResource ProfileItem}" SelectionChanged="AppList_SelectionChanged"
                     MouseDoubleClick="AppList_DoubleClick" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Hover}" Margin="0,0,12,0">
                                <Image Source="{Binding Icon}" Margin="4" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="Browse for executable..." Style="{StaticResource Btn}" DockPanel.Dock="Left" Click="Browse_Click" />
            <Button x:Name="SelectBtn" Content="Select" Style="{StaticResource BtnPrimary}" DockPanel.Dock="Right" Click="Select_Click" IsEnabled="False" />
            <Button Content="Cancel" Style="{StaticResource Btn}" DockPanel.Dock="Right" Margin="0,0,8,0" Click="Cancel_Click" />
        </DockPanel>
    </Grid>
</Window>
